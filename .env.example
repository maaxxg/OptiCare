# Database (dev-only credentials; under docker compose the host is overridden to "db")
DATABASE_URL=postgresql+psycopg://opticare:opticare@localhost:5432/opticare
# Host port of the compose db (default 5432). If you change it, use the same port in DATABASE_URL
# when running the backend outside Docker.
# DB_PORT=5432
CHECK_DB_ON_STARTUP=true

# LLM adapter: mock | api (no provider chosen by default)
LLM_BACKEND=mock
# Any OpenAI-compatible server; the URL ends before /chat/completions,
# e.g. LLM_BASE_URL=https://host.example/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_S=30

# Routing adapter: mock | ors
ROUTING_BACKEND=mock
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org

# Geocoding and SMS adapters (mock only for now)
GEOCODING_BACKEND=mock
SMS_BACKEND=mock
